{
	"name": "acrop",
	"version": "0.0.14",
	"description": "",
	"keywords": [],
	"homepage": "https://github.com/crescware/acrop#readme",
	"bugs": {
		"url": "https://github.com/crescware/acrop/issues"
	},
	"license": "MIT",
	"author": "Crescware Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crescware/acrop.git"
	},
	"bin": {
		"acrop": "./dist/index.mjs"
	},
	"files": [
		"dist",
		"src",
		"package.json",
		"README.md"
	],
	"type": "module",
	"main": "index.js",
	"scripts": {
		"bench": "pnpm run build && node ./scripts/benchmark.mts",
		"build": "pnpm run check && pnpm run build:cli",
		"build:cli": "tsup ./index.ts --format esm && echo '#!/usr/bin/env node' | cat - dist/index.js > dist/index.mjs && chmod +x dist/index.mjs && rm dist/index.js",
		"check": "pnpm run check:types && pnpm run check:lint && pnpm run check:format && pnpm run test",
		"check:format": "oxfmt --check",
		"check:lint": "oxlint",
		"check:types": "tsc -p ./tsconfig.json --noEmit",
		"format": "oxfmt --write",
		"prepack": "pnpm run build",
		"start": "pnpm run build:cli && node ./dist/index.mjs",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"arg": "~5.0.2",
		"detect-newline": "~4.0.1",
		"ignore": "~5.3.2",
		"minimatch": "~10.0.1",
		"oxc-parser": "~0.61.2",
		"oxc-transform": "~0.61.2",
		"table": "~6.9.0",
		"time-span": "~5.1.0",
		"valibot": "~1.0.0",
		"yoctocolors": "~2.1.1"
	},
	"devDependencies": {
		"@types/node": "~20.17.27",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"ts-essentials": "~10.0.4",
		"tsup": "8.4.0",
		"typescript": "7.0.2",
		"vitest": "~3.0.9"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@12.21.0"
}
