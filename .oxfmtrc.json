{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 80,
	"sortImports": {
		"newlinesBetween": false,
		"partitionByNewline": true
	},
	"sortPackageJson": {
		"sortScripts": true
	},
	"ignorePatterns": ["/.next/", "/dist/", "/coverage/", "/pnpm-lock.yaml"]
}
